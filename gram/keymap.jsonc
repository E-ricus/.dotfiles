[
  {
    "context": "Editor && vim_operator == none && !VimWaiting && vim_mode != insert",
    "bindings": {
      "space `": "workspace::ToggleLeftDock",
      "space space": "pane::AlternateFile",
      "shift k": "editor::Hover",
      "space k": "editor::Hover",
      "space t": "workspace::ToggleBottomDock",
      "g r": "editor::FindAllReferences",
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToImplementation",
      "ctrl-space": "editor::ShowCompletions",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] g": "editor::GoToHunk",
      "[ g": "editor::GoToPreviousHunk",
      "space f f": "file_finder::Toggle",
      "space f b": "tab_switcher::Toggle",
      "space /": "workspace::NewSearch",
      "space l a": "editor::ToggleCodeActions",
      "space l r": "editor::Rename",
      "space g g": "git_panel::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      // rust-analyzer target switching (same keys as helix/nvim)
      "space r t h": ["task::Spawn", { "task_name": "rust-analyzer target: host" }],
      "space r t w": ["task::Spawn", { "task_name": "rust-analyzer target: windows" }],
      "cmd /": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-l": ["workspace::SendKeystrokes", "escape"]
    }
  }
]
